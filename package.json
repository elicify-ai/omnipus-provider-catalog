  "description": "Daily assembler for the Omnipus providers_catalog.json (ADR-067 D1, schema 2.0.0)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "tsx src/cli.ts fetch",
    "assemble": "tsx src/cli.ts assemble",
